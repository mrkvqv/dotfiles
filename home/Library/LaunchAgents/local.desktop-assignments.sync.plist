<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.desktop-assignments.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/desktop-assignments-sync</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>WatchPaths</key>
    <array>
        <string>__HOME__/.config/desktop-assignments.json</string>
    </array>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/desktop-assignments-sync.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/desktop-assignments-sync.log</string>
</dict>
</plist>
