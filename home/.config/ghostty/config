theme = Midnight MacBook
# Terminal-only blue replacements; keep Zed's syntax palette independent.
palette = 4=#d3cbd8
palette = 12=#ded6e3
# Plum-tinted glass; colors and opacity come from the shared Zed theme.
background-blur = 24
font-size = 14
window-padding-x = 6,14
window-padding-y = 4,12
window-padding-balance = false
cursor-style = bar


keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9
