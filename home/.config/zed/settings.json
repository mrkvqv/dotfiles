{
  "edit_predictions": {
    "provider": "zed"
  },
  "icon_theme": "Zed (Default)",
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "right",
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "mode": "full-access"
      },
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Midnight MacBook",
  },
  "language_models": {
    "anthropic": {},
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-3-5-sonnet-latest",
    },
  },
}
